# Genera una clave segura con: python scripts/generate_env.py
DJANGO_SECRET_KEY=REEMPLAZAR_POR_CLAVE_ALEATORIA
DJANGO_DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=0
# Usuarios de demostración: activar solamente en entorno de desarrollo
ENABLE_DEMO_USERS=0
DEMO_PASSWORD=REEMPLAZAR_POR_CONTRASENA_SEGURA
# AWS opcional: usar perfil IAM del servidor EC2 (no subir credenciales a Git)
AWS_S3_BUCKET=
AWS_REGION=us-east-1
